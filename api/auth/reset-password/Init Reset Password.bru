meta {
  name: Init Reset Password
  type: http
  seq: 1
}

post {
  url: {{appURL}}/api/v1/auth/reset-password/init
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "john.doe@example.com"
  }
}

tests {
  test("status is 200 or 404", function() {
    expect(res.status).to.be.oneOf([200, 404]);
  });

  test("response structure is valid", function() {
    const body = res.body;
    expect(body).to.be.an("object");
    if (res.status === 200) {
      expect(body.success).to.be.true;
      expect(body.msg).to.equal("Verification code sent successfully");
    } else if (res.status === 404) {
      expect(body.success).to.be.false;
      expect(body.msg).to.equal("Email is not registered");
    }
  });
}

docs {
  # Initiate Password Reset
  
  Initiates a password reset request. Validates the email address, verifies the user exists in MongoDB, generates a 6-digit OTP stored in Redis with a 5-minute TTL, and sends a transactional security notification email with the OTP and client request context (IP, location, device).
  
  ## Request
  - **Method:** `POST`
  - **Endpoint:** `/api/v1/auth/reset-password/init`
  - **Rate Limit:** 5 requests/minute per IP (Key: `auth:reset-password:init:<ip>`)
  
  ## Request Body
  | Field | Type | Required | Description |
  |---|---|---|---|
  | `email` | `string` | Yes | Registered account email address. |
  
  ```json
  {
    "email": "john.doe@example.com"
  }
  ```
  
  ## Responses
  - **200 OK:** Reset OTP dispatched to registered email.
    ```json
    {
      "success": true,
      "msg": "Verification code sent successfully",
      "metadata": null,
      "timestamp": 1732550000000
    }
    ```
  - **404 Not Found:** Email does not exist in the database.
    ```json
    {
      "success": false,
      "msg": "Email is not registered",
      "metadata": null,
      "timestamp": 1732550000000
    }
    ```
}
