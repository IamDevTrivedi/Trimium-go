meta {
  name: Reset Password
  type: http
  seq: 3
}

post {
  url: {{appURL}}/api/v1/auth/reset-password/reset
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "john.doe@example.com",
    "password": "NewSecurePass456!"
  }
}

tests {
  test("status is 200, 400, or 404", function() {
    expect(res.status).to.be.oneOf([200, 400, 404]);
  });

  test("response structure is valid", function() {
    const body = res.body;
    expect(body).to.be.an("object");
    if (res.status === 200) {
      expect(body.success).to.be.true;
      expect(body.msg).to.equal("Password reset successfully");
    } else {
      expect(body.success).to.be.false;
      expect(body.msg).to.be.a("string");
    }
  });
}

docs {
  # Set New Password (Reset)
  
  Applies the new password to the user account in MongoDB after OTP verification.
  
  - Validates password complexity (minimum 10 characters, lowercase, uppercase, digit, special character).
  - Confirms Redis state is `VERIFIED`.
  - Hashes the password with Argon2id.
  - Updates `password_hash` and `updated_at` in the database.
  - Deletes the Redis OTP key upon completion to prevent replay attacks.
  
  ## Request
  - **Method:** `POST`
  - **Endpoint:** `/api/v1/auth/reset-password/reset`
  - **Rate Limit:** 5 requests/minute per IP (Key: `auth:reset-password:<ip>`)
  
  ## Request Body
  | Field | Type | Required | Description |
  |---|---|---|---|
  | `email` | `string` | Yes | Target user email address. |
  | `password` | `string` | Yes | New password (10-128 chars, lowercase, uppercase, number, symbol). |
  
  ```json
  {
    "email": "john.doe@example.com",
    "password": "NewSecurePass456!"
  }
  ```
  
  ## Responses
  - **200 OK:** Password updated successfully.
    ```json
    {
      "success": true,
      "msg": "Password reset successfully",
      "metadata": null,
      "timestamp": 1732550000000
    }
    ```
  - **400 Bad Request:** Unverified/expired session or password complexity requirements failed.
  - **404 Not Found:** Email does not exist.
}
