meta {
  name: Redis Health
  type: http
  seq: 2
}

get {
  url: {{appURL}}/api/v1/healthz/redis
  body: none
  auth: none
}

tests {
  test("status is 200 or 503", function() {
    expect(res.status).to.be.oneOf([200, 503]);
  });

  test("response payload matches status", function() {
    const body = res.body;
    expect(body).to.be.an("object");
    if (res.status === 200) {
      expect(body.success).to.be.true;
      expect(body.msg).to.equal("Redis is working");
    } else {
      expect(body.success).to.be.false;
      expect(body.msg).to.equal("Redis is not working");
    }
  });
}

docs {
  # Redis Connection Health Check
  
  Checks the API server's connection to the Redis cache/session store.
  
  ## Request
  - **Method:** `GET`
  - **Endpoint:** `/api/v1/healthz/redis`
  - **Authentication:** None
  - **Rate Limit:** 50 requests/minute per IP (Key: `health:redis:<ip>`)
  
  ## Responses
  - **200 OK:** Redis is reachable and responding to PING.
    ```json
    {
      "success": true,
      "msg": "Redis is working",
      "metadata": { "ping": "PONG" },
      "timestamp": 1732550000000
    }
    ```
  - **503 Service Unavailable:** Redis connection failed.
    ```json
    {
      "success": false,
      "msg": "Redis is not working",
      "metadata": null,
      "timestamp": 1732550000000
    }
    ```
}
